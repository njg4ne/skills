# Validation tooling for this repository. This is not any skill's build image.
# Provides the Agent Skills reference validator (skills-ref) and shellcheck,
# pinned so every run on every machine agrees. dev/validate.sh builds it and
# runs dev/check.sh inside it.
FROM docker.io/library/python:3.12-slim@sha256:dddfd7e07f9d15aeeca61529320492139d21cac7f0070c00609243e51e4e0016

RUN apt-get update \
 && apt-get install -y --no-install-recommends git shellcheck \
 && rm -rf /var/lib/apt/lists/*

# skills-ref has no release on PyPI; install it from a pinned commit of the spec repo.
ARG SKILLS_REF_COMMIT=69ef37e9424c0a7ea9dd2293b559e43ec8176379
RUN pip install --no-cache-dir \
      "skills-ref @ git+https://github.com/agentskills/agentskills.git@${SKILLS_REF_COMMIT}#subdirectory=skills-ref"

WORKDIR /work
